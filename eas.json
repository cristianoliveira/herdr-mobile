{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.23.1",
      "pnpm": "10.21.0"
    },
    "development-pixel": {
      "extends": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a --max-workers=1 -x lintVitalAnalyzeRelease"
      },
      "node": "22.23.1",
      "pnpm": "10.21.0",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.23.1",
      "pnpm": "10.21.0",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
